  "node": [
    {"index": 0, "code": 1000, "key": "NODE_AREA", "unitsUS": "ft2", "unitsSI": "m2", "definition": "surface area used in the depth update, max(Xnode.newSurfArea, MinSurfArea)", "source": "setNodeDepth"},
