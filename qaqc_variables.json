    {"index": 10, "code": 1010, "key": "SUBCATCH_IMP_AREA_NoDS", "unitsUS": "ac", "unitsSI": "ha", "definition": "impervious area without depression storage, non-LID area x subArea[IMPERV0].fArea", "source": "input"},
