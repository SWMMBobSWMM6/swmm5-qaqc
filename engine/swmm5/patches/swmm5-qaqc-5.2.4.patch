+#include "qaqc.h"                                              // QAQC:
 #include "lid.h"
 //-----------------------------------------------------------------------------
 // Shared variables
@@ -215,6 +216,17 @@
     double   stepFlowError;            // 1 - (system outflow) / (system inflow)
 
     if ( ErrorCode ) return;
+    QaqcRouteStep = routingStep;                                   // QAQC:
+    QaqcTrials = 0;                                                // QAQC:
+    if ( QaqcNode )                                                // QAQC:
+    {                                                              // QAQC:
+        int qj;                                                    // QAQC:
